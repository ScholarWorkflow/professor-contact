#!/usr/bin/env python3
"""Same-directory entry for ``stage2_input_router.py`` (professor-contact).

Installed copies invoke the deterministic runners through these same-directory
entries, so one install can pin the interpreter of the real runner chain (the
Nix staging rewrites this shebang) without changing any public ``.py``
interface. The entry resolves the adjacent original script from its own
location, forwards argv unchanged and replaces itself with that script, which
keeps stdout, stderr and the exit code of the original runner.

An install that owns a locked Zotero exporter also translates the router's
existing exporter choice: the caller keeps passing the loaded ``zotero-read``
skill directory, and this entry replaces that locator with the locked
``--exporter`` executable. An explicit ``--exporter`` keeps the original
single-executable override semantics and is forwarded untouched.
"""

from __future__ import annotations

import os
import shutil
import sys
from pathlib import Path

TARGET = Path(__file__).resolve().parent / "stage2_input_router.py"


def locked_exporter() -> str:
    """Locked Zotero export executable, or ``""`` for the caller locator.

    The Nix staging substitutes the store path of the export entry shipped
    with this install; a checkout or APM install keeps it empty, so the
    locator passed by the caller reaches the original router unchanged.
    """
    return ""  # NIX_STAGING_EXPORTER: empty keeps the caller-supplied locator


def bind_exporter(argv: list[str], exporter: str) -> list[str]:
    """Bind the router's mutually exclusive exporter choice to one executable.

    ``stage2_input_router.py`` accepts either ``--exporter <one executable>``
    or ``--zotero-read-skill-dir <directory>``, never both. An install with a
    locked executable replaces a caller-supplied skill directory with that
    executable; an explicit ``--exporter`` wins and stays unchanged.
    """
    if any(arg == "--exporter" or arg.startswith("--exporter=") for arg in argv):
        return list(argv)
    forwarded: list[str] = []
    index = 0
    while index < len(argv):
        arg = argv[index]
        if arg == "--zotero-read-skill-dir":
            if index + 1 >= len(argv):
                # A value-less locator is malformed input: keep the original
                # argv so the router's own argparse reports the missing value.
                return list(argv)
            index += 2
            continue
        if arg.startswith("--zotero-read-skill-dir="):
            index += 1
            continue
        forwarded.append(arg)
        index += 1
    return [*forwarded, "--exporter", exporter]


def main() -> None:
    interpreter = sys.executable or shutil.which("python3") or "python3"
    argv = list(sys.argv[1:])
    exporter = locked_exporter()
    if exporter:
        argv = bind_exporter(argv, exporter)
    os.execv(interpreter, [interpreter, str(TARGET), *argv])


if __name__ == "__main__":
    main()
